<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg"
    android:padding="32dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_pin"
        android:layout_marginBottom="16dp">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_graduation"
            android:contentDescription="" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Emploi du temps UCA"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Connecte-toi une fois avec ton compte UCA pour débloquer l'agenda, les lieux, la messagerie et toutes les autres fonctionnalités."
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_cta"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="Se connecter"
        android:textAllCaps="false"
        android:textColor="@color/on_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/gateError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Connexion annulée, réessaie."
        android:textColor="@color/danger"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
