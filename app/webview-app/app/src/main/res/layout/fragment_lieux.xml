<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <include layout="@layout/topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- BANDEAU CONSENTEMENT COOKIES GOOGLE MAPS -->
            <LinearLayout
                android:id="@+id/cookieConsentBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:text="🍪 COOKIES GOOGLE MAPS &amp; GÉOLOCALISATION"
                    android:textColor="@color/accent2"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Pour afficher la carte interactive des campus de l'Université Clermont Auvergne (Cézeaux, Dunant, Carnot, Gergovia), vous devez accepter les cookies Google Maps."
                    android:textColor="@color/text"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btnAcceptCookies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_cta"
                        android:text="Accepter les cookies"
                        android:textAllCaps="false"
                        android:textColor="@color/on_accent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                    <Button
                        android:id="@+id/btnRefuseCookies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_card"
                        android:text="Refuser (Mode liste)"
                        android:textAllCaps="false"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="7dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                </LinearLayout>
            </LinearLayout>

            <!-- ÉCRAN CARTE INTERACTIVE (Affiché une fois les cookies acceptés) -->
            <FrameLayout
                android:id="@+id/mapContainer"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_margin="16dp"
                android:visibility="gone">

                <WebView
                    android:id="@+id/mapWebView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <TextView
                android:text="LIEUX UNIVERSITAIRES UCA &amp; RESTOS CROUS"
                android:textColor="@color/text_dim"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:id="@+id/lieuxContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp"
                android:divider="@drawable/divider_row"
                android:showDividers="middle" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
