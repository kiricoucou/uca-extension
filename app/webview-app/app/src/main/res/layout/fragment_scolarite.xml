<?xml version="1.0" encoding="utf-8"?>
<!-- Contenu vérifiable uniquement : aucune donnée inventée (mêmes textes que app/shell.js de l'app web). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg">
    <include layout="@layout/topbar" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginBottom="12dp">
            <TextView android:text="DOCUMENTS ADMINISTRATIFS" android:textColor="@color/text_dim" android:textSize="12sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Certificat de scolarité" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Se télécharge sur l'ENT (rubrique Scolarité), avec ta connexion UCA. Valable pour la mutuelle, la T2C et le CROUS." android:textColor="@color/text_dim" android:textSize="13sp" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/btnDownloadCertificat" android:text="Ouvrir l'ENT" android:layout_marginTop="10dp" android:background="@drawable/bg_cta" android:textColor="@color/on_accent" android:textAllCaps="false" android:textStyle="bold" android:minHeight="48dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginBottom="12dp">
            <TextView android:text="NOTES &amp; RELEVÉS" android:textColor="@color/text_dim" android:textSize="12sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Relevé officiel sur Odin ; tes notes synchronisées sont dans l'agenda (menu → Notes)." android:textColor="@color/text_dim" android:textSize="13sp" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/btnOdinNotes" android:text="Odin : relevé officiel" android:layout_marginTop="10dp" android:background="@drawable/bg_cta" android:textColor="@color/on_accent" android:textAllCaps="false" android:textStyle="bold" android:minHeight="48dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginBottom="12dp">
            <TextView android:text="CONTACTS" android:textColor="@color/text_dim" android:textSize="12sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Secrétariat pédagogique de ton département" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Coordonnées et horaires sur l'ENT et sur le site de l'IUT (iut.uca.fr). L'app n'affiche pas de numéro qu'elle ne peut pas vérifier." android:textColor="@color/text_dim" android:textSize="13sp" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
