<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <include layout="@layout/topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:text="PÉRIODES &amp; DÉMARCHES DE STAGE"
                android:textColor="@color/text_dim"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:text="Stage BUT Informatique S4"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:text="Du 12 avril au 25 juin 2027 (10 à 12 semaines) · Obligatoire pour la validation du BUT 2."
                    android:textColor="@color/text_dim"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:text="Conventions de stage gérées via le portail PStage UCA sur l'ENT."
                    android:textColor="@color/accent2"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <TextView
                android:text="OFFRES LOCALES &amp; PARTENAIRES UCA"
                android:textColor="@color/text_dim"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:paddingHorizontal="12dp"
                android:divider="@drawable/divider_row"
                android:showDividers="middle"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="12dp">
                    <TextView
                        android:text="Michelin — Clermont-Ferrand"
                        android:textColor="@color/accent2"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:text="Stage Développeur Full-Stack / Mobile Android"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:text="Ref: MICH-2026-DEV · Rémunération légale + tickets resto · Cézeaux / Ladoux"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="12dp">
                    <TextView
                        android:text="CGI France — Aubière Campus Cézeaux"
                        android:textColor="@color/accent2"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:text="Stage / Alternance Ingénieur DevOps &amp; Cloud"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:text="Ref: CGI-AUB-2026 · CI/CD, Kubernetes, Python · À 500m de l'IUT"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="12dp">
                    <TextView
                        android:text="Almerys — Clermont-Ferrand"
                        android:textColor="@color/accent2"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:text="Stage Cybersécurité &amp; Protection des Données"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:text="Ref: ALM-SEC-2026 · Audits, protocoles de sécurité santé · Centre Jaude"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
