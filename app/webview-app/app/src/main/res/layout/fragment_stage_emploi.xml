<?xml version="1.0" encoding="utf-8"?>
<!-- Contenu vérifiable uniquement : aucune donnée inventée (mêmes textes que app/shell.js de l'app web). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg">
    <include layout="@layout/topbar" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginBottom="12dp">
            <TextView android:text="DÉMARCHES DE STAGE" android:textColor="@color/text_dim" android:textSize="12sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Les périodes de stage dépendent de ta formation : regarde l'emploi du temps et les annonces de ton département. Les conventions se font sur le portail PStage, depuis l'ENT." android:textColor="@color/text_dim" android:textSize="13sp" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/btnPstage" android:text="Ouvrir l'ENT (PStage)" android:layout_marginTop="10dp" android:background="@drawable/bg_cta" android:textColor="@color/on_accent" android:textAllCaps="false" android:textStyle="bold" android:minHeight="48dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginBottom="12dp">
            <TextView android:text="OFFRES" android:textColor="@color/text_dim" android:textSize="12sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="L'app n'invente pas d'offres : elle renvoie aux sources officielles." android:textColor="@color/text_dim" android:textSize="13sp" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/btnOffresUca" android:text="Offres de l'université" android:layout_marginTop="10dp" android:background="@drawable/bg_cta" android:textColor="@color/on_accent" android:textAllCaps="false" android:textStyle="bold" android:minHeight="48dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/btn1j1s" android:text="1jeune1solution (État)" android:layout_marginTop="10dp" android:background="@drawable/bg_cta" android:textColor="@color/on_accent" android:textAllCaps="false" android:textStyle="bold" android:minHeight="48dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
