<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget"
    android:padding="12dp">

    <TextView
        android:id="@+id/wLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textColor="@color/text_dim"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/wK1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" android:layout_marginBottom="5dp" android:background="@drawable/bg_widget_btn" android:gravity="center" android:text="Agenda" android:textColor="@color/on_accent" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/wK2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginBottom="5dp" android:background="@drawable/bg_widget_btn" android:gravity="center" android:text="Notes" android:textColor="@color/on_accent" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <TextView android:id="@+id/wK3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" android:layout_marginTop="5dp" android:background="@drawable/bg_widget_btn" android:gravity="center" android:text="Absences" android:textColor="@color/on_accent" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/wK4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginTop="5dp" android:background="@drawable/bg_widget_btn" android:gravity="center" android:text="Devoirs" android:textColor="@color/on_accent" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
