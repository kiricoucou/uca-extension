{
  "manifest_version": 3,
  "name": "Emploi du temps UCA (non officiel)",
  "version": "1.19.0",
  "description": "Extension non officielle, non affiliée à l'Université Clermont Auvergne. Récupère ton emploi du temps, tes absences et tes notes depuis Odin avec ta propre session, et les affiche dans la barre d'outils. Aucune donnée n'est envoyée à un serveur tiers : tout reste dans ton navigateur.",
  "permissions": ["scripting", "storage", "cookies", "alarms", "notifications"],
  "host_permissions": [
    "https://ent.uca.fr/*",
    "https://odin.iut.uca.fr/*",
    "https://raw.githubusercontent.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "choose.html",
    "default_title": "Emploi du temps UCA",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["file:///*", "http://localhost/*", "http://127.0.0.1/*", "https://kiricoucou.github.io/uca-extension/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
